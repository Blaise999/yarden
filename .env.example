# YARDEN V8 — SAMPLE ONLY. Never commit .env.local or paste API keys into chat.
# The linked Upstash and Blob credentials can be provisioned automatically on Vercel.
# First-time setup: create two DIFFERENT 32-byte random secrets (64 hex chars).
ADMIN_SESSION_SECRET=
YARD_SETUP_TOKEN=

# Only one Redis pair is necessary (either UPSTASH_* or KV_*).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Blob: recent Vercel stores normally use OIDC and inject the credentials automatically.
# Legacy token-backed stores may provide BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN=

# Email: a fresh key from Resend, and an address on YOUR verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_REPLY_TO=

# Required for newsletter unsubscribe links and email links. Use YOUR actual domain.
NEXT_PUBLIC_SITE_URL=
