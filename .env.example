# YARDEN V8 — SAMPLE ONLY. Never commit .env.local or paste API keys into chat.
# The linked Upstash and Blob credentials can be provisioned automatically on Vercel.
# First-time setup: create two DIFFERENT 32-byte random secrets (64 hex chars).
ADMIN_SESSION_SECRET=
YARD_SETUP_TOKEN=

# Only one Redis pair is necessary (either UPSTASH_* or KV_*).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Blob: recent Vercel stores normally use OIDC and inject the credentials automatically.
# Legacy token-backed stores may provide BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN=

# Email: a fresh key from Resend, and an address on YOUR verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_REPLY_TO=

# Required for newsletter unsubscribe links and email links. Use YOUR actual domain.
NEXT_PUBLIC_SITE_URL=

# V10 OPTIONAL: if Git LFS is not enabled on Vercel, upload the real videos
# to your PUBLIC Vercel Blob store and paste their direct URLs here.
# Unchanged default CMS video paths will use these Blob URLs when provided.
# Custom per-video URLs saved in Admin -> Settings override these values.
# NEXT_PUBLIC_YARDEN_DESKTOP_VIDEO_URL=
# NEXT_PUBLIC_YARDEN_MOBILE_VIDEO_URL=

# V15: silent original-resolution playback is the default.
# Local files: /videos/yarden-desktop-uhd.mp4 and yarden-mobile-uhd.mp4.
# Upload these to PUBLIC Vercel Blob to use a CDN; paste public URLs below.
# 4K_URL takes precedence over VIDEO_URL. No credentials in NEXT_PUBLIC values.
# NEXT_PUBLIC_YARDEN_DESKTOP_4K_URL=
# NEXT_PUBLIC_YARDEN_MOBILE_4K_URL=
# NEXT_PUBLIC_YARDEN_DESKTOP_POSTER_URL=
# NEXT_PUBLIC_YARDEN_MOBILE_POSTER_URL=
